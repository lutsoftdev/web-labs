{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests per second (demo-app)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_total{service_name=\"demo-app\"}[5m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Error rate % (5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_total{service_name=\"demo-app\", status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_total{service_name=\"demo-app\"}[5m])), 1e-9)",
          "legendFormat": "error%",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"demo-app\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "logs",
      "title": "Error logs (demo-app)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "{service_name=\"demo-app\"} |= \"error\"",
          "refId": "A"
        }
      ],
      "datasource": { "type": "loki", "uid": "loki" }
    }
  ],
  "schemaVersion": 39,
  "tags": ["softshop", "red", "lab08"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
